CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_VERSION_REPO="https://mirrors.pku.edu.cn/immortalwrt/snapshots"
# iStore
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y
# OpenClash
CONFIG_PACKAGE_luci-app-openclash=y
# Argon 3 theme (latest master, forced as default by 99zz-argon-default)
CONFIG_PACKAGE_luci-theme-argon=y
# Removed themes: Aurora / Alpha / Liquid
# CONFIG_PACKAGE_luci-theme-aurora is not set
# CONFIG_PACKAGE_luci-app-aurora-config is not set
# CONFIG_PACKAGE_luci-theme-alpha is not set
# CONFIG_PACKAGE_luci-app-alpha-config is not set
# CONFIG_PACKAGE_luci-theme-liquid is not set
# Homebox (latest v1.0.1 binary + LuCI app)
CONFIG_PACKAGE_homebox=y
CONFIG_PACKAGE_luci-app-homebox=y
# QuickStart dashboard (iStoreOS home page) + backend
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-app-quickstart=y
# QuickStart backend dependencies
CONFIG_PACKAGE_shadow-utils=y
CONFIG_PACKAGE_shadow-useradd=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_smartd=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_PACKAGE_mdadm=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_bash=y
# Shanghai timezone data
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_zoneinfo-asia=y
# PassWall (core proxies only; no Rust build)
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# Airoha NPU status app (luanmuc Chinese edition) + Chinese translation
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y
# Speed test
CONFIG_PACKAGE_luci-app-netspeedtest=y
# Web terminal
CONFIG_PACKAGE_luci-app-ttyd=y
# Task plan
CONFIG_PACKAGE_luci-app-taskplan=y
# Power off
CONFIG_PACKAGE_luci-app-poweroffdevice=y
# Per-IP traffic statistics
CONFIG_PACKAGE_luci-app-wrtbwmon=y
CONFIG_PACKAGE_wrtbwmon=y
# Ad filtering
CONFIG_PACKAGE_luci-app-adbyby-plus=y
CONFIG_PACKAGE_adbyby=y
# Removed: UPnP IGD / PCP/NAT-PMP service and statistics
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_collectd is not set
# i2c-tools pulls target python3 (missing libffi) and is unused on airoha
# CONFIG_PACKAGE_i2c-tools is not set
# CONFIG_PACKAGE_libi2c is not set
